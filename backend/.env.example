# Copia este archivo como .env y llena los valores. NUNCA subas .env a git.
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@cluster0.qg5yexf.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB=finanzas
PORT=3000

# Autenticación: usuarios propios en MongoDB (colección "usuarios") con token JWT.
#   mongo (por defecto) | firebase | dev (solo pruebas: confía en el header x-user-id)
AUTH_PROVIDER=mongo
# Clave para firmar los tokens. Debe ser larga, aleatoria y secreta.
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=pon-aqui-una-cadena-aleatoria-de-64-caracteres
JWT_DURACION=30d

# Moneda principal por defecto si el usuario no tiene preferencias guardadas
MONEDA_BASE_DEFECTO=COP
